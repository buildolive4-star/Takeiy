rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- AUTH & ROLE PRIMITIVES ---
    function isSignedIn() {
      return request.auth != null;
    }

    function userEmail() {
      return ('email' in request.auth.token && request.auth.token.email is string)
        ? request.auth.token.email
        : '';
    }

    function isMainAdmin() {
      return isSignedIn() &&
        'email' in request.auth.token &&
        'email_verified' in request.auth.token &&
        request.auth.token.email == 'buildolive4@gmail.com' &&
        request.auth.token.email_verified == true;
    }

    function coAdminDocExists() {
      return isSignedIn() &&
        userEmail() != '' &&
        exists(/databases/$(database)/documents/takeit_co_admins/$(userEmail()));
    }

    function coAdminData() {
      return get(/databases/$(database)/documents/takeit_co_admins/$(userEmail())).data;
    }

    function isActiveStaffRecord() {
      return coAdminDocExists() && coAdminData().activeFlag == true;
    }

    function staffRoleType() {
      return ('roleType' in coAdminData() && coAdminData().roleType is string)
        ? coAdminData().roleType
        : 'CO_ADMIN';
    }

    function isActiveCoAdmin() {
      return isActiveStaffRecord() && staffRoleType() == 'CO_ADMIN';
    }

    function isRestaurantOwner() {
      return isActiveStaffRecord() &&
        staffRoleType() == 'RESTAURANT_OWNER' &&
        ('assignedRestaurantId' in coAdminData()) &&
        coAdminData().assignedRestaurantId is string &&
        coAdminData().assignedRestaurantId != '';
    }

    function isDeliveryPartner() {
      return isActiveStaffRecord() && staffRoleType() == 'DELIVERY_PARTNER';
    }

    function isStaff() {
      return isMainAdmin() || isActiveCoAdmin();
    }

    function canManageOrders() {
      return isMainAdmin() || (isActiveCoAdmin() && coAdminData().canManageOrders == true);
    }

    function canManageRestaurants() {
      return isMainAdmin() || (isActiveCoAdmin() && coAdminData().canManageRestaurants == true);
    }

    function canManageCoupons() {
      return isMainAdmin() || (isActiveCoAdmin() && coAdminData().canManageCoupons == true);
    }

    function canManageUsers() {
      return isMainAdmin() || (isActiveCoAdmin() && coAdminData().canManageUsers == true);
    }

    function canManageSettings() {
      return isMainAdmin() || (isActiveCoAdmin() && coAdminData().canManageSettings == true);
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidTimestamp(ts) {
      return ts is timestamp && ts <= request.time;
    }

    function isSafeImageUrl(url) {
      return url is string && url.size() <= 600 && (url == '' || url.matches('^https://.*'));
    }

    // --- VALIDATION FUNCTIONS ---
    function isValidConfig(data) {
      return data.appName is string && data.appName.size() >= 1 && data.appName.size() <= 60 &&
        data.cityName is string && data.cityName.size() >= 1 && data.cityName.size() <= 80 &&
        (!('heroBannerTitle' in data) || (data.heroBannerTitle is string && data.heroBannerTitle.size() <= 120)) &&
        (!('heroBannerSubtitle' in data) || (data.heroBannerSubtitle is string && data.heroBannerSubtitle.size() <= 180)) &&
        (!('heroBannerCode' in data) || (data.heroBannerCode is string && data.heroBannerCode.size() <= 40)) &&
        (!('lateNightTitle' in data) || (data.lateNightTitle is string && data.lateNightTitle.size() <= 120)) &&
        (!('lateNightSubtitle' in data) || (data.lateNightSubtitle is string && data.lateNightSubtitle.size() <= 180)) &&
        data.deliveryFee is int && data.deliveryFee >= 0 && data.deliveryFee <= 500 &&
        data.platformFee is int && data.platformFee >= 0 && data.platformFee <= 200 &&
        data.gstPercent is int && data.gstPercent >= 0 && data.gstPercent <= 28 &&
        (!('freeDeliveryAbove' in data) || (data.freeDeliveryAbove is int && data.freeDeliveryAbove >= 0 && data.freeDeliveryAbove <= 50000)) &&
        data.maintenanceMode is bool &&
        data.acceptingOrders is bool &&
        (!('supportPhone' in data) || (data.supportPhone is string && data.supportPhone.size() <= 40)) &&
        (!('supportEmail' in data) || (data.supportEmail is string && data.supportEmail.size() <= 120)) &&
        (!('supportWhatsapp' in data) || (data.supportWhatsapp is string && data.supportWhatsapp.size() <= 40)) &&
        (!('supportTelegram' in data) || (data.supportTelegram is string && data.supportTelegram.size() <= 80)) &&
        (!('sosNumber' in data) || (data.sosNumber is string && data.sosNumber.size() <= 20)) &&
        (!('waitingChargePerMin' in data) || (data.waitingChargePerMin is int && data.waitingChargePerMin >= 0 && data.waitingChargePerMin <= 200)) &&
        (!('nightSurgePercent' in data) || (data.nightSurgePercent is int && data.nightSurgePercent >= 0 && data.nightSurgePercent <= 200)) &&
        (!('peakMultiplier' in data) || (data.peakMultiplier is number && data.peakMultiplier >= 1 && data.peakMultiplier <= 5)) &&
        (!('cancellationFee' in data) || (data.cancellationFee is int && data.cancellationFee >= 0 && data.cancellationFee <= 500)) &&
        (!('walletMinTopup' in data) || (data.walletMinTopup is int && data.walletMinTopup >= 1 && data.walletMinTopup <= 5000)) &&
        (!('aboutUsText' in data) || (data.aboutUsText is string && data.aboutUsText.size() <= 1200)) &&
        (!('termsText' in data) || (data.termsText is string && data.termsText.size() <= 2000)) &&
        (!('privacyText' in data) || (data.privacyText is string && data.privacyText.size() <= 2000)) &&
        (!('announcementText' in data) || (data.announcementText is string && data.announcementText.size() <= 300)) &&
        isValidTimestamp(data.updatedAt);
    }

    function isValidCoAdmin(data, docEmail) {
      return data.email is string && data.email == docEmail && data.email.size() >= 5 && data.email.size() <= 120 &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 80 &&
        data.roleTitle is string && data.roleTitle.size() >= 1 && data.roleTitle.size() <= 60 &&
        (!('roleType' in data) || (data.roleType is string && data.roleType in ['CO_ADMIN', 'RESTAURANT_OWNER', 'DELIVERY_PARTNER'])) &&
        (!('assignedRestaurantId' in data) || (data.assignedRestaurantId is string && data.assignedRestaurantId.size() <= 128)) &&
        (!('assignedRestaurantName' in data) || (data.assignedRestaurantName is string && data.assignedRestaurantName.size() <= 120)) &&
        (!('phone' in data) || (data.phone is string && data.phone.size() <= 30)) &&
        (!('vehicleNumber' in data) || (data.vehicleNumber is string && data.vehicleNumber.size() <= 40)) &&
        data.passcode is string && data.passcode.size() >= 4 && data.passcode.size() <= 40 &&
        data.activeFlag is bool &&
        data.canManageOrders is bool &&
        data.canManageRestaurants is bool &&
        data.canManageCoupons is bool &&
        data.canManageUsers is bool &&
        data.canManageSettings is bool &&
        data.createdBy is string && data.createdBy.size() <= 120 &&
        isValidTimestamp(data.createdAt) &&
        isValidTimestamp(data.updatedAt);
    }

    function isValidFoodCategory(data) {
      return data.name is string && data.name.size() >= 1 && data.name.size() <= 60 &&
        (!('emoji' in data) || (data.emoji is string && data.emoji.size() <= 16)) &&
        (!('imageUrl' in data) || isSafeImageUrl(data.imageUrl)) &&
        (!('sortOrder' in data) || (data.sortOrder is int && data.sortOrder >= 0 && data.sortOrder <= 1000)) &&
        data.activeFlag is bool &&
        isValidTimestamp(data.createdAt) &&
        isValidTimestamp(data.updatedAt);
    }

    function isValidHeroBanner(data) {
      return (!('title' in data) || (data.title is string && data.title.size() <= 120)) &&
        (!('subtitle' in data) || (data.subtitle is string && data.subtitle.size() <= 180)) &&
        (!('imageUrl' in data) || isSafeImageUrl(data.imageUrl)) &&
        (!('restaurantId' in data) || (data.restaurantId is string && data.restaurantId.size() <= 128)) &&
        (!('promoCode' in data) || (data.promoCode is string && data.promoCode.size() <= 40)) &&
        (!('sortOrder' in data) || (data.sortOrder is int && data.sortOrder >= 0 && data.sortOrder <= 1000)) &&
        data.activeFlag is bool &&
        isValidTimestamp(data.createdAt) &&
        isValidTimestamp(data.updatedAt);
    }

    function isValidRestaurant(data) {
      return data.name is string && data.name.size() >= 1 && data.name.size() <= 100 &&
        data.cuisine is string && data.cuisine.size() >= 1 && data.cuisine.size() <= 120 &&
        data.category is string && data.category.size() >= 1 && data.category.size() <= 60 &&
        data.rating is number && data.rating >= 0 && data.rating <= 5 &&
        (!('ratingCount' in data) || (data.ratingCount is string && data.ratingCount.size() <= 40)) &&
        data.deliveryTime is string && data.deliveryTime.size() >= 1 && data.deliveryTime.size() <= 40 &&
        data.priceForTwo is int && data.priceForTwo >= 10 && data.priceForTwo <= 50000 &&
        (!('offerTag' in data) || (data.offerTag is string && data.offerTag.size() <= 40)) &&
        (!('offerCode' in data) || (data.offerCode is string && data.offerCode.size() <= 40)) &&
        (!('address' in data) || (data.address is string && data.address.size() <= 240)) &&
        (!('imageUrl' in data) || isSafeImageUrl(data.imageUrl)) &&
        (!('offerImageUrl' in data) || isSafeImageUrl(data.offerImageUrl)) &&
        (!('latitude' in data) || (data.latitude is number && data.latitude >= -90 && data.latitude <= 90)) &&
        (!('longitude' in data) || (data.longitude is number && data.longitude >= -180 && data.longitude <= 180)) &&
        (!('ownerEmail' in data) || (data.ownerEmail is string && data.ownerEmail.size() <= 120)) &&
        (!('pureVegFlag' in data) || data.pureVegFlag is bool) &&
        (!('freeDeliveryFlag' in data) || data.freeDeliveryFlag is bool) &&
        (!('verifiedFlag' in data) || data.verifiedFlag is bool) &&
        data.openFlag is bool &&
        (!('featuredFlag' in data) || data.featuredFlag is bool) &&
        isValidTimestamp(data.createdAt) &&
        isValidTimestamp(data.updatedAt);
    }

    function isValidMenuItem(data) {
      return data.restaurantId is string && data.restaurantId.size() >= 1 && data.restaurantId.size() <= 128 &&
        data.restaurantName is string && data.restaurantName.size() >= 1 && data.restaurantName.size() <= 100 &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 120 &&
        (!('description' in data) || (data.description is string && data.description.size() <= 300)) &&
        data.category is string && data.category.size() >= 1 && data.category.size() <= 60 &&
        data.price is int && data.price >= 1 && data.price <= 50000 &&
        (!('originalPrice' in data) || (data.originalPrice is int && data.originalPrice >= 0 && data.originalPrice <= 60000)) &&
        data.vegFlag is bool &&
        data.availableFlag is bool &&
        data.bestsellerFlag is bool &&
        data.rating is number && data.rating >= 0 && data.rating <= 5 &&
        (!('imageUrl' in data) || isSafeImageUrl(data.imageUrl)) &&
        isValidTimestamp(data.createdAt) &&
        isValidTimestamp(data.updatedAt);
    }

    function isValidCoupon(data) {
      return data.code is string && data.code.size() >= 2 && data.code.size() <= 30 &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 100 &&
        (!('description' in data) || (data.description is string && data.description.size() <= 240)) &&
        data.discountType is string && data.discountType in ['PERCENT', 'FLAT'] &&
        data.discountValue is int && data.discountValue >= 1 && data.discountValue <= 10000 &&
        data.maxDiscount is int && data.maxDiscount >= 0 && data.maxDiscount <= 10000 &&
        data.minOrderAmount is int && data.minOrderAmount >= 0 && data.minOrderAmount <= 50000 &&
        data.activeFlag is bool &&
        isValidTimestamp(data.createdAt) &&
        isValidTimestamp(data.updatedAt);
    }

    function isValidFoodOrder(data) {
      return data.orderNumber is string && data.orderNumber.size() >= 2 && data.orderNumber.size() <= 40 &&
        data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
        data.customerName is string && data.customerName.size() >= 1 && data.customerName.size() <= 100 &&
        (!('customerEmail' in data) || (data.customerEmail is string && data.customerEmail.size() <= 120)) &&
        (!('customerPhone' in data) || (data.customerPhone is string && data.customerPhone.size() <= 30)) &&
        data.restaurantId is string && data.restaurantId.size() >= 1 && data.restaurantId.size() <= 128 &&
        data.restaurantName is string && data.restaurantName.size() >= 1 && data.restaurantName.size() <= 120 &&
        data.itemsSummary is string && data.itemsSummary.size() >= 1 && data.itemsSummary.size() <= 500 &&
        data.itemTotal is int && data.itemTotal >= 0 && data.itemTotal <= 500000 &&
        (!('deliveryFee' in data) || (data.deliveryFee is int && data.deliveryFee >= 0 && data.deliveryFee <= 5000)) &&
        (!('platformFee' in data) || (data.platformFee is int && data.platformFee >= 0 && data.platformFee <= 5000)) &&
        (!('gstAmount' in data) || (data.gstAmount is int && data.gstAmount >= 0 && data.gstAmount <= 100000)) &&
        (!('discountAmount' in data) || (data.discountAmount is int && data.discountAmount >= 0 && data.discountAmount <= 100000)) &&
        (!('couponCode' in data) || (data.couponCode is string && data.couponCode.size() <= 40)) &&
        data.totalAmount is int && data.totalAmount >= 0 && data.totalAmount <= 500000 &&
        data.paymentMethod is string && data.paymentMethod in ['RAZORPAY', 'WALLET', 'COD', 'UPI'] &&
        data.paymentStatus is string && data.paymentStatus in ['PAID', 'PENDING', 'REFUNDED'] &&
        (!('paymentRef' in data) || (data.paymentRef is string && data.paymentRef.size() <= 120)) &&
        data.deliveryAddress is string && data.deliveryAddress.size() >= 1 && data.deliveryAddress.size() <= 350 &&
        (!('deliveryLat' in data) || (data.deliveryLat is number && data.deliveryLat >= -90 && data.deliveryLat <= 90)) &&
        (!('deliveryLng' in data) || (data.deliveryLng is number && data.deliveryLng >= -180 && data.deliveryLng <= 180)) &&
        (!('pickupLat' in data) || (data.pickupLat is number && data.pickupLat >= -90 && data.pickupLat <= 90)) &&
        (!('pickupLng' in data) || (data.pickupLng is number && data.pickupLng >= -180 && data.pickupLng <= 180)) &&
        data.status is string && data.status in ['PLACED', 'CONFIRMED', 'PREPARING', 'OUT_FOR_DELIVERY', 'DELIVERED', 'CANCELLED', 'REFUNDED'] &&
        (!('riderName' in data) || (data.riderName is string && data.riderName.size() <= 80)) &&
        (!('riderPhone' in data) || (data.riderPhone is string && data.riderPhone.size() <= 30)) &&
        (!('riderVehicle' in data) || (data.riderVehicle is string && data.riderVehicle.size() <= 40)) &&
        (!('etaMinutes' in data) || (data.etaMinutes is int && data.etaMinutes >= 0 && data.etaMinutes <= 240)) &&
        data.otp is string && data.otp.size() <= 12 &&
        data.rating is int && data.rating >= 0 && data.rating <= 5 &&
        (!('reviewText' in data) || (data.reviewText is string && data.reviewText.size() <= 400)) &&
        isValidTimestamp(data.createdAt) &&
        isValidTimestamp(data.updatedAt);
    }

    function isValidTakeItUser(data, userId) {
      return data.userId is string && data.userId == userId &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 100 &&
        (!('email' in data) || (data.email is string && data.email.size() <= 120)) &&
        (!('phone' in data) || (data.phone is string && data.phone.size() <= 30)) &&
        (!('avatarUrl' in data) || isSafeImageUrl(data.avatarUrl)) &&
        (!('activeAddressLabel' in data) || (data.activeAddressLabel is string && data.activeAddressLabel.size() <= 80)) &&
        (!('activeAddressLine' in data) || (data.activeAddressLine is string && data.activeAddressLine.size() <= 350)) &&
        data.walletBalance is number && data.walletBalance >= 0 && data.walletBalance <= 1000000 &&
        data.goldMemberFlag is bool &&
        data.suspendedFlag is bool &&
        (!('favoriteRestaurantIds' in data) || (data.favoriteRestaurantIds is list && data.favoriteRestaurantIds.size() <= 100)) &&
        isValidTimestamp(data.createdAt) &&
        isValidTimestamp(data.updatedAt);
    }

    function isValidReview(data) {
      return data.userId is string && data.userId == request.auth.uid &&
        data.userName is string && data.userName.size() >= 1 && data.userName.size() <= 80 &&
        data.restaurantId is string && data.restaurantId.size() >= 1 && data.restaurantId.size() <= 128 &&
        (!('orderId' in data) || (data.orderId is string && data.orderId.size() <= 128)) &&
        data.rating is int && data.rating >= 1 && data.rating <= 5 &&
        data.comment is string && data.comment.size() <= 400 &&
        isValidTimestamp(data.createdAt);
    }

    function isValidSupportTicket(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
        data.userName is string && data.userName.size() >= 1 && data.userName.size() <= 80 &&
        (!('userEmail' in data) || (data.userEmail is string && data.userEmail.size() <= 120)) &&
        data.subject is string && data.subject.size() >= 1 && data.subject.size() <= 120 &&
        data.message is string && data.message.size() >= 1 && data.message.size() <= 600 &&
        data.status is string && data.status in ['OPEN', 'IN_PROGRESS', 'RESOLVED'] &&
        (!('adminReply' in data) || (data.adminReply is string && data.adminReply.size() <= 600)) &&
        isValidTimestamp(data.createdAt) &&
        isValidTimestamp(data.updatedAt);
    }

    function isValidAddress(data, userId) {
      return data.userId is string && data.userId == userId &&
        data.label is string && data.label.size() >= 1 && data.label.size() <= 60 &&
        data.fullAddress is string && data.fullAddress.size() >= 1 && data.fullAddress.size() <= 350 &&
        (!('landmark' in data) || (data.landmark is string && data.landmark.size() <= 160)) &&
        (!('city' in data) || (data.city is string && data.city.size() <= 80)) &&
        (!('areaStreet' in data) || (data.areaStreet is string && data.areaStreet.size() <= 120)) &&
        (!('mapLink' in data) || (data.mapLink is string && data.mapLink.size() <= 350)) &&
        (!('receiverName' in data) || (data.receiverName is string && data.receiverName.size() <= 90)) &&
        (!('receiverPhone' in data) || (data.receiverPhone is string && data.receiverPhone.size() <= 30)) &&
        (!('forSomeoneElse' in data) || data.forSomeoneElse is bool) &&
        (!('latitude' in data) || (data.latitude is number && data.latitude >= -90 && data.latitude <= 90)) &&
        (!('longitude' in data) || (data.longitude is number && data.longitude >= -180 && data.longitude <= 180)) &&
        isValidTimestamp(data.createdAt) &&
        isValidTimestamp(data.updatedAt);
    }

    function isValidWalletTx(data, userId) {
      return data.userId is string && data.userId == userId &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 140 &&
        data.txType is string && data.txType in ['CREDIT', 'DEBIT', 'CASHBACK', 'REFUND', 'PROMO'] &&
        data.amount is number && data.amount >= 0 && data.amount <= 500000 &&
        data.method is string && data.method.size() >= 1 && data.method.size() <= 60 &&
        isValidTimestamp(data.createdAt);
    }

    // --- 1. STAFF / CO-ADMIN / PARTNER REGISTRY ---
    match /takeit_co_admins/{coAdminEmail} {
      allow get: if isMainAdmin() || isActiveCoAdmin() || (isSignedIn() && userEmail() == coAdminEmail);
      allow list: if isMainAdmin() || isActiveCoAdmin();
      allow create, update: if isValidCoAdmin(incoming(), coAdminEmail) && (
        isMainAdmin() ||
        (isActiveCoAdmin() && (!('roleType' in incoming()) || incoming().roleType in ['RESTAURANT_OWNER', 'DELIVERY_PARTNER']))
      );
      allow delete: if isMainAdmin() || (isActiveCoAdmin() && ('roleType' in existing()) && existing().roleType in ['RESTAURANT_OWNER', 'DELIVERY_PARTNER']);
    }

    // --- 2. GLOBAL LIVE APP CONFIG ---
    match /takeit_config/{configId} {
      allow get, list: if isSignedIn();
      allow create, update: if canManageSettings() && isValidId(configId) && isValidConfig(incoming());
      allow delete: if isMainAdmin();
    }

    // --- 2B. DYNAMIC FOOD CATEGORIES ---
    match /takeit_categories/{categoryId} {
      allow get, list: if isSignedIn();
      allow create, update: if canManageRestaurants() && isValidId(categoryId) && isValidFoodCategory(incoming());
      allow delete: if canManageRestaurants();
    }

    // --- 2C. HERO BANNER CAROUSEL SLIDES ---
    match /takeit_hero_banners/{bannerId} {
      allow get, list: if isSignedIn();
      allow create, update: if (canManageSettings() || canManageRestaurants()) && isValidId(bannerId) && isValidHeroBanner(incoming());
      allow delete: if canManageSettings() || canManageRestaurants();
    }

    // --- 3. RESTAURANTS CATALOG ---
    match /takeit_restaurants/{restaurantId} {
      allow get, list: if isSignedIn();
      allow create: if canManageRestaurants() && isValidId(restaurantId) && isValidRestaurant(incoming());
      allow update: if isValidId(restaurantId) && isValidRestaurant(incoming()) && (
        canManageRestaurants() ||
        (isRestaurantOwner() && restaurantId == coAdminData().assignedRestaurantId)
      );
      allow delete: if canManageRestaurants();
    }

    // --- 4. MENU ITEMS ---
    match /takeit_menu_items/{itemId} {
      allow get, list: if isSignedIn();
      allow create, update: if isValidId(itemId) && isValidMenuItem(incoming()) && (
        canManageRestaurants() ||
        (isRestaurantOwner() && incoming().restaurantId == coAdminData().assignedRestaurantId)
      );
      allow delete: if canManageRestaurants() || (isRestaurantOwner() && existing().restaurantId == coAdminData().assignedRestaurantId);
    }

    // --- 5. PROMO COUPONS (ADMIN & CO-ADMIN ONLY) ---
    match /takeit_coupons/{couponId} {
      allow get, list: if isSignedIn();
      allow create, update: if canManageCoupons() && isValidId(couponId) && isValidCoupon(incoming());
      allow delete: if canManageCoupons();
    }

    // --- 6. LIVE FOOD ORDERS ---
    match /takeit_orders/{orderId} {
      allow get: if isSignedIn() && (
        isOwner(existing().userId) ||
        canManageOrders() ||
        isStaff() ||
        isDeliveryPartner() ||
        (isRestaurantOwner() && existing().restaurantId == coAdminData().assignedRestaurantId)
      );
      allow list: if isSignedIn() && (
        canManageOrders() ||
        isStaff() ||
        isDeliveryPartner() ||
        (isRestaurantOwner() && resource.data.restaurantId == coAdminData().assignedRestaurantId) ||
        resource.data.userId == request.auth.uid
      );

      allow create: if isSignedIn() &&
        isValidId(orderId) &&
        incoming().userId == request.auth.uid &&
        incoming().status == 'PLACED' &&
        isValidFoodOrder(incoming());

      allow update: if isSignedIn() &&
        isValidId(orderId) &&
        isValidFoodOrder(incoming()) &&
        incoming().userId == existing().userId &&
        incoming().createdAt == existing().createdAt &&
        (
          canManageOrders() ||
          isDeliveryPartner() ||
          (
            isRestaurantOwner() &&
            existing().restaurantId == coAdminData().assignedRestaurantId &&
            incoming().restaurantId == existing().restaurantId
          ) ||
          (
            isOwner(existing().userId) &&
            existing().status == 'DELIVERED' &&
            incoming().status == 'DELIVERED' &&
            incoming().diff(existing()).affectedKeys().hasOnly(['rating', 'reviewText', 'updatedAt'])
          ) ||
          (
            isOwner(existing().userId) &&
            existing().status == 'PLACED' &&
            incoming().status == 'CANCELLED' &&
            incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])
          )
        );

      allow delete: if isMainAdmin();
    }

    function isValidRideBooking(data) {
      return data.rideNumber is string && data.rideNumber.size() >= 2 && data.rideNumber.size() <= 40 &&
        data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
        data.customerName is string && data.customerName.size() >= 1 && data.customerName.size() <= 100 &&
        (!('customerEmail' in data) || (data.customerEmail is string && data.customerEmail.size() <= 120)) &&
        (!('customerPhone' in data) || (data.customerPhone is string && data.customerPhone.size() <= 30)) &&
        data.vehicleType is string && data.vehicleType.size() >= 1 && data.vehicleType.size() <= 50 &&
        (!('bookingCategory' in data) || (data.bookingCategory is string && data.bookingCategory.size() <= 40)) &&
        (!('scheduledFor' in data) || (data.scheduledFor is string && data.scheduledFor.size() <= 60)) &&
        data.pickupAddress is string && data.pickupAddress.size() >= 1 && data.pickupAddress.size() <= 300 &&
        data.dropAddress is string && data.dropAddress.size() >= 1 && data.dropAddress.size() <= 300 &&
        (!('pickupLat' in data) || (data.pickupLat is number && data.pickupLat >= -90 && data.pickupLat <= 90)) &&
        (!('pickupLng' in data) || (data.pickupLng is number && data.pickupLng >= -180 && data.pickupLng <= 180)) &&
        (!('dropLat' in data) || (data.dropLat is number && data.dropLat >= -90 && data.dropLat <= 90)) &&
        (!('dropLng' in data) || (data.dropLng is number && data.dropLng >= -180 && data.dropLng <= 180)) &&
        data.distanceKm is int && data.distanceKm >= 1 && data.distanceKm <= 500 &&
        (!('durationMin' in data) || (data.durationMin is int && data.durationMin >= 0 && data.durationMin <= 1440)) &&
        (!('baseFare' in data) || (data.baseFare is int && data.baseFare >= 0 && data.baseFare <= 50000)) &&
        (!('distanceCharge' in data) || (data.distanceCharge is int && data.distanceCharge >= 0 && data.distanceCharge <= 100000)) &&
        (!('timeCharge' in data) || (data.timeCharge is int && data.timeCharge >= 0 && data.timeCharge <= 50000)) &&
        (!('waitingCharge' in data) || (data.waitingCharge is int && data.waitingCharge >= 0 && data.waitingCharge <= 50000)) &&
        (!('surchargeAmount' in data) || (data.surchargeAmount is int && data.surchargeAmount >= 0 && data.surchargeAmount <= 50000)) &&
        (!('platformFee' in data) || (data.platformFee is int && data.platformFee >= 0 && data.platformFee <= 5000)) &&
        (!('gstAmount' in data) || (data.gstAmount is int && data.gstAmount >= 0 && data.gstAmount <= 25000)) &&
        (!('discountAmount' in data) || (data.discountAmount is int && data.discountAmount >= 0 && data.discountAmount <= 50000)) &&
        (!('couponCode' in data) || (data.couponCode is string && data.couponCode.size() <= 40)) &&
        (!('commissionAmount' in data) || (data.commissionAmount is int && data.commissionAmount >= 0 && data.commissionAmount <= 50000)) &&
        (!('driverEarnings' in data) || (data.driverEarnings is int && data.driverEarnings >= 0 && data.driverEarnings <= 100000)) &&
        data.totalFare is int && data.totalFare >= 0 && data.totalFare <= 100000 &&
        data.paymentMethod is string && data.paymentMethod in ['RAZORPAY', 'WALLET', 'COD', 'CASH', 'UPI', 'CARD'] &&
        data.paymentStatus is string && data.paymentStatus in ['PAID', 'PENDING', 'PAY_ON_DROP', 'PAY_ON_DELIVERY', 'REFUNDED'] &&
        (!('paymentRef' in data) || (data.paymentRef is string && data.paymentRef.size() <= 120)) &&
        data.status is string && data.status in ['REQUESTED', 'CAPTAIN_ASSIGNED', 'ARRIVING', 'ON_TRIP', 'COMPLETED', 'CANCELLED', 'REFUNDED'] &&
        (!('captainName' in data) || (data.captainName is string && data.captainName.size() <= 80)) &&
        (!('captainPhone' in data) || (data.captainPhone is string && data.captainPhone.size() <= 30)) &&
        (!('vehicleNumber' in data) || (data.vehicleNumber is string && data.vehicleNumber.size() <= 40)) &&
        (!('etaMinutes' in data) || (data.etaMinutes is int && data.etaMinutes >= 0 && data.etaMinutes <= 240)) &&
        data.otp is string && data.otp.size() <= 12 &&
        (!('otpVerified' in data) || data.otpVerified is bool) &&
        (!('sosActive' in data) || data.sosActive is bool) &&
        data.rating is int && data.rating >= 0 && data.rating <= 5 &&
        isValidTimestamp(data.createdAt) &&
        isValidTimestamp(data.updatedAt);
    }

    function isValidParcelOrder(data) {
      return data.parcelNumber is string && data.parcelNumber.size() >= 2 && data.parcelNumber.size() <= 40 &&
        data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
        data.senderName is string && data.senderName.size() >= 1 && data.senderName.size() <= 100 &&
        (!('senderEmail' in data) || (data.senderEmail is string && data.senderEmail.size() <= 120)) &&
        (!('senderPhone' in data) || (data.senderPhone is string && data.senderPhone.size() <= 30)) &&
        data.receiverName is string && data.receiverName.size() >= 1 && data.receiverName.size() <= 100 &&
        data.receiverPhone is string && data.receiverPhone.size() >= 3 && data.receiverPhone.size() <= 30 &&
        data.pickupAddress is string && data.pickupAddress.size() >= 1 && data.pickupAddress.size() <= 300 &&
        data.dropAddress is string && data.dropAddress.size() >= 1 && data.dropAddress.size() <= 300 &&
        (!('pickupLat' in data) || (data.pickupLat is number && data.pickupLat >= -90 && data.pickupLat <= 90)) &&
        (!('pickupLng' in data) || (data.pickupLng is number && data.pickupLng >= -180 && data.pickupLng <= 180)) &&
        (!('dropLat' in data) || (data.dropLat is number && data.dropLat >= -90 && data.dropLat <= 90)) &&
        (!('dropLng' in data) || (data.dropLng is number && data.dropLng >= -180 && data.dropLng <= 180)) &&
        (!('distanceKm' in data) || (data.distanceKm is int && data.distanceKm >= 1 && data.distanceKm <= 2000)) &&
        data.vehicleType is string && data.vehicleType.size() >= 1 && data.vehicleType.size() <= 50 &&
        (!('bodyType' in data) || (data.bodyType is string && data.bodyType.size() <= 40)) &&
        data.packageType is string && data.packageType.size() >= 1 && data.packageType.size() <= 80 &&
        data.weightKg is int && data.weightKg >= 1 && data.weightKg <= 10000 &&
        data.fragileFlag is bool &&
        (!('baseFare' in data) || (data.baseFare is int && data.baseFare >= 0 && data.baseFare <= 100000)) &&
        (!('distanceCharge' in data) || (data.distanceCharge is int && data.distanceCharge >= 0 && data.distanceCharge <= 100000)) &&
        (!('platformFee' in data) || (data.platformFee is int && data.platformFee >= 0 && data.platformFee <= 5000)) &&
        (!('gstAmount' in data) || (data.gstAmount is int && data.gstAmount >= 0 && data.gstAmount <= 25000)) &&
        (!('discountAmount' in data) || (data.discountAmount is int && data.discountAmount >= 0 && data.discountAmount <= 50000)) &&
        (!('couponCode' in data) || (data.couponCode is string && data.couponCode.size() <= 40)) &&
        (!('driverEarnings' in data) || (data.driverEarnings is int && data.driverEarnings >= 0 && data.driverEarnings <= 200000)) &&
        data.totalFare is int && data.totalFare >= 0 && data.totalFare <= 200000 &&
        data.paymentMethod is string && data.paymentMethod in ['RAZORPAY', 'WALLET', 'COD', 'CASH', 'UPI', 'CARD'] &&
        data.paymentStatus is string && data.paymentStatus in ['PAID', 'PENDING', 'PAY_ON_DROP', 'PAY_ON_DELIVERY', 'REFUNDED'] &&
        (!('paymentRef' in data) || (data.paymentRef is string && data.paymentRef.size() <= 120)) &&
        data.status is string && data.status in ['BOOKED', 'PARTNER_ASSIGNED', 'PICKED_UP', 'IN_TRANSIT', 'DELIVERED', 'CANCELLED', 'REFUNDED'] &&
        (!('partnerName' in data) || (data.partnerName is string && data.partnerName.size() <= 80)) &&
        (!('partnerPhone' in data) || (data.partnerPhone is string && data.partnerPhone.size() <= 30)) &&
        (!('vehicleNumber' in data) || (data.vehicleNumber is string && data.vehicleNumber.size() <= 40)) &&
        (!('etaMinutes' in data) || (data.etaMinutes is int && data.etaMinutes >= 0 && data.etaMinutes <= 480)) &&
        data.otp is string && data.otp.size() <= 12 &&
        data.rating is int && data.rating >= 0 && data.rating <= 5 &&
        isValidTimestamp(data.createdAt) &&
        isValidTimestamp(data.updatedAt);
    }

    // --- 6B. LIVE RIDEX RIDES ---
    match /takeit_rides/{rideId} {
      allow get: if isSignedIn() && (isOwner(existing().userId) || canManageOrders() || isStaff() || isDeliveryPartner());
      allow list: if isSignedIn() && (canManageOrders() || isStaff() || isDeliveryPartner() || resource.data.userId == request.auth.uid);

      allow create: if isSignedIn() &&
        isValidId(rideId) &&
        incoming().userId == request.auth.uid &&
        incoming().status == 'REQUESTED' &&
        isValidRideBooking(incoming());

      allow update: if isSignedIn() &&
        isValidId(rideId) &&
        isValidRideBooking(incoming()) &&
        incoming().userId == existing().userId &&
        incoming().createdAt == existing().createdAt &&
        (
          canManageOrders() ||
          isDeliveryPartner() ||
          (
            isOwner(existing().userId) &&
            existing().status == 'COMPLETED' &&
            incoming().status == 'COMPLETED' &&
            incoming().diff(existing()).affectedKeys().hasOnly(['rating', 'updatedAt'])
          ) ||
          (
            isOwner(existing().userId) &&
            incoming().diff(existing()).affectedKeys().hasOnly(['sosActive', 'updatedAt'])
          ) ||
          (
            isOwner(existing().userId) &&
            existing().status == 'REQUESTED' &&
            incoming().status == 'CANCELLED' &&
            incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])
          )
        );

      allow delete: if isMainAdmin();
    }

    // --- 6C. LIVE MOVEX PARCEL & GOODS TRANSPORT ---
    match /takeit_parcels/{parcelId} {
      allow get: if isSignedIn() && (isOwner(existing().userId) || canManageOrders() || isStaff() || isDeliveryPartner());
      allow list: if isSignedIn() && (canManageOrders() || isStaff() || isDeliveryPartner() || resource.data.userId == request.auth.uid);

      allow create: if isSignedIn() &&
        isValidId(parcelId) &&
        incoming().userId == request.auth.uid &&
        incoming().status == 'BOOKED' &&
        isValidParcelOrder(incoming());

      allow update: if isSignedIn() &&
        isValidId(parcelId) &&
        isValidParcelOrder(incoming()) &&
        incoming().userId == existing().userId &&
        incoming().createdAt == existing().createdAt &&
        (
          canManageOrders() ||
          isDeliveryPartner() ||
          (
            isOwner(existing().userId) &&
            existing().status == 'DELIVERED' &&
            incoming().status == 'DELIVERED' &&
            incoming().diff(existing()).affectedKeys().hasOnly(['rating', 'updatedAt'])
          ) ||
          (
            isOwner(existing().userId) &&
            existing().status == 'BOOKED' &&
            incoming().status == 'CANCELLED' &&
            incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])
          )
        );

      allow delete: if isMainAdmin();
    }

    // --- 6D. MOBILITY VEHICLE CATEGORIES & DYNAMIC PRICING ---
    match /takeit_vehicle_categories/{vehicleId} {
      allow get, list: if isSignedIn();
      allow create, update: if isStaff() && isValidId(vehicleId) &&
        incoming().vertical in ['RIDE', 'TRANSPORT'] &&
        incoming().code is string && incoming().code.size() >= 1 && incoming().code.size() <= 40 &&
        incoming().name is string && incoming().name.size() >= 1 && incoming().name.size() <= 80 &&
        incoming().baseFare is int && incoming().baseFare >= 0 &&
        incoming().perKmRate is int && incoming().perKmRate >= 0 &&
        incoming().activeFlag is bool;
      allow delete: if isStaff();
    }

    // --- 6E. CAPTAIN KYC PROFILES ---
    match /takeit_captains/{captainUid} {
      allow get: if isSignedIn() && (isOwner(captainUid) || isStaff() || isDeliveryPartner());
      allow list: if isStaff() || isDeliveryPartner();
      allow create: if isSignedIn() && isValidId(captainUid) && isOwner(captainUid) &&
        incoming().userId == captainUid &&
        incoming().approvalStatus == 'PENDING';
      allow update: if isSignedIn() && isValidId(captainUid) && (
        isStaff() ||
        (
          isOwner(captainUid) &&
          incoming().userId == existing().userId &&
          incoming().approvalStatus == existing().approvalStatus &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'fullName', 'phone', 'vehicleCategory', 'vehicleModel', 'vehicleNumber',
            'licenseNumber', 'aadhaarLast4', 'bankAccount', 'ifscCode',
            'licensePhotoUrl', 'vehiclePhotoUrl', 'onlineFlag', 'updatedAt'
          ])
        )
      );
      allow delete: if isMainAdmin();
    }

    // --- 6F. CAPTAIN WITHDRAWAL PAYOUT REQUESTS ---
    match /takeit_withdrawals/{withdrawalId} {
      allow get: if isSignedIn() && (isOwner(existing().captainUserId) || isStaff());
      allow list: if isSignedIn() && (isStaff() || resource.data.captainUserId == request.auth.uid);
      allow create: if isSignedIn() && isValidId(withdrawalId) &&
        incoming().captainUserId == request.auth.uid &&
        incoming().status == 'PENDING' &&
        incoming().amount is number && incoming().amount > 0;
      allow update: if isStaff() && isValidId(withdrawalId);
      allow delete: if isMainAdmin();
    }

    // --- 7. REVIEWS ---
    match /takeit_reviews/{reviewId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() && isValidId(reviewId) && isValidReview(incoming());
      allow update: if false;
      allow delete: if isStaff() || (isSignedIn() && resource.data.userId == request.auth.uid);
    }

    // --- 8. SUPPORT TICKETS ---
    match /takeit_support_tickets/{ticketId} {
      allow get: if isSignedIn() && (isOwner(existing().userId) || isStaff());
      allow list: if isSignedIn() && (isStaff() || resource.data.userId == request.auth.uid);

      allow create: if isSignedIn() &&
        isValidId(ticketId) &&
        incoming().userId == request.auth.uid &&
        incoming().status == 'OPEN' &&
        isValidSupportTicket(incoming());

      allow update: if isStaff() &&
        isValidId(ticketId) &&
        isValidSupportTicket(incoming()) &&
        incoming().userId == existing().userId &&
        incoming().createdAt == existing().createdAt;

      allow delete: if isMainAdmin();
    }

    // --- 9. CUSTOMER PROFILES & PRIVATE SUBCOLLECTIONS ---
    match /takeit_users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && (isOwner(userId) || canManageUsers() || isStaff());
      allow list: if canManageUsers() || isStaff();

      allow create: if isSignedIn() &&
        isValidId(userId) &&
        isOwner(userId) &&
        incoming().suspendedFlag == false &&
        isValidTakeItUser(incoming(), userId);

      allow update: if isSignedIn() &&
        isValidId(userId) &&
        isValidTakeItUser(incoming(), userId) &&
        incoming().userId == existing().userId &&
        incoming().createdAt == existing().createdAt &&
        (
          canManageUsers() ||
          (
            isOwner(userId) &&
            incoming().suspendedFlag == existing().suspendedFlag &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'name', 'email', 'phone', 'avatarUrl',
              'activeAddressLabel', 'activeAddressLine',
              'walletBalance', 'goldMemberFlag', 'favoriteRestaurantIds', 'updatedAt'
            ])
          )
        );

      allow delete: if isMainAdmin();

      match /addresses/{addressId} {
        allow get, list: if isSignedIn() && (isOwner(userId) || isStaff());
        allow create, update: if isSignedIn() && isValidId(addressId) && isOwner(userId) && isValidAddress(incoming(), userId);
        allow delete: if isSignedIn() && (isOwner(userId) || isMainAdmin());
      }

      match /wallet_transactions/{txId} {
        allow get, list: if isSignedIn() && (isOwner(userId) || isStaff());
        allow create: if isSignedIn() && isValidId(txId) && (isOwner(userId) || canManageUsers()) && isValidWalletTx(incoming(), userId);
        allow update, delete: if isMainAdmin();
      }

      match /emergency_contacts/{contactId} {
        allow get, list: if isSignedIn() && (isOwner(userId) || isStaff());
        allow create, update, delete: if isSignedIn() && isValidId(contactId) && isOwner(userId);
      }
    }
  }
}
