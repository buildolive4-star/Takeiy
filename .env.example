# IMGBB_API_KEY: Free ImgBB Image Hosting API key (https://api.imgbb.com/) for uploading Profile, Dish & Grocery photos.
# Configure this in the Secrets panel in AI Studio AND in GitHub Repo Settings -> Secrets -> Actions as IMGBB_API_KEY.
IMGBB_API_KEY=YOUR_IMGBB_API_KEY

# PEXELS_API_KEY: Optional Pexels Stock Photo API key for dynamic catalog photos (falls back to built-in 3D art).
PEXELS_API_KEY=YOUR_PEXELS_API_KEY
