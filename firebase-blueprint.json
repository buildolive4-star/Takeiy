{
  "entities": {
    "TakeItConfig": {
      "title": "TakeItConfig",
      "description": "Live global configuration controlled by Main Admin & Co-Admins, synced in real time to Customer App.",
      "type": "object",
      "properties": {
        "appName": { "type": "string" },
        "cityName": { "type": "string" },
        "heroBannerTitle": { "type": "string" },
        "heroBannerSubtitle": { "type": "string" },
        "heroBannerCode": { "type": "string" },
        "lateNightTitle": { "type": "string" },
        "lateNightSubtitle": { "type": "string" },
        "deliveryFee": { "type": "integer" },
        "platformFee": { "type": "integer" },
        "gstPercent": { "type": "integer" },
        "freeDeliveryAbove": { "type": "integer" },
        "maintenanceMode": { "type": "boolean" },
        "acceptingOrders": { "type": "boolean" },
        "supportPhone": { "type": "string" },
        "supportEmail": { "type": "string" },
        "announcementText": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["appName", "cityName", "deliveryFee", "platformFee", "gstPercent", "maintenanceMode", "acceptingOrders", "updatedAt"]
    },
    "CoAdmin": {
      "title": "CoAdmin",
      "description": "Co-Admin account created and controlled exclusively by Main Admin (buildolive4@gmail.com) with custom password and granular permissions.",
      "type": "object",
      "properties": {
        "email": { "type": "string" },
        "name": { "type": "string" },
        "roleTitle": { "type": "string" },
        "passcode": { "type": "string" },
        "activeFlag": { "type": "boolean" },
        "canManageOrders": { "type": "boolean" },
        "canManageRestaurants": { "type": "boolean" },
        "canManageCoupons": { "type": "boolean" },
        "canManageUsers": { "type": "boolean" },
        "canManageSettings": { "type": "boolean" },
        "createdBy": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["email", "name", "roleTitle", "passcode", "activeFlag", "canManageOrders", "canManageRestaurants", "canManageCoupons", "canManageUsers", "canManageSettings", "createdBy", "createdAt", "updatedAt"]
    },
    "Restaurant": {
      "title": "Restaurant",
      "description": "Live restaurant entry managed by Admin and browsed by Customers.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "cuisine": { "type": "string" },
        "category": { "type": "string" },
        "rating": { "type": "number" },
        "ratingCount": { "type": "string" },
        "deliveryTime": { "type": "string" },
        "priceForTwo": { "type": "integer" },
        "offerTag": { "type": "string" },
        "offerCode": { "type": "string" },
        "address": { "type": "string" },
        "imageUrl": { "type": "string" },
        "pureVegFlag": { "type": "boolean" },
        "freeDeliveryFlag": { "type": "boolean" },
        "verifiedFlag": { "type": "boolean" },
        "openFlag": { "type": "boolean" },
        "featuredFlag": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "cuisine", "category", "rating", "deliveryTime", "priceForTwo", "openFlag", "createdAt", "updatedAt"]
    },
    "MenuItem": {
      "title": "MenuItem",
      "description": "Live restaurant dish managed by Admin and ordered by Customers.",
      "type": "object",
      "properties": {
        "restaurantId": { "type": "string" },
        "restaurantName": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "category": { "type": "string" },
        "price": { "type": "integer" },
        "originalPrice": { "type": "integer" },
        "vegFlag": { "type": "boolean" },
        "availableFlag": { "type": "boolean" },
        "bestsellerFlag": { "type": "boolean" },
        "rating": { "type": "number" },
        "imageUrl": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["restaurantId", "restaurantName", "name", "category", "price", "vegFlag", "availableFlag", "bestsellerFlag", "rating", "createdAt", "updatedAt"]
    },
    "Coupon": {
      "title": "Coupon",
      "description": "Live promo coupon created by Admin and applied in Customer Cart.",
      "type": "object",
      "properties": {
        "code": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "discountType": { "type": "string" },
        "discountValue": { "type": "integer" },
        "maxDiscount": { "type": "integer" },
        "minOrderAmount": { "type": "integer" },
        "activeFlag": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["code", "title", "discountType", "discountValue", "maxDiscount", "minOrderAmount", "activeFlag", "createdAt", "updatedAt"]
    },
    "FoodOrder": {
      "title": "FoodOrder",
      "description": "Live food delivery order synced between Customer App and Admin Command Center.",
      "type": "object",
      "properties": {
        "orderNumber": { "type": "string" },
        "userId": { "type": "string" },
        "customerName": { "type": "string" },
        "customerEmail": { "type": "string" },
        "customerPhone": { "type": "string" },
        "restaurantId": { "type": "string" },
        "restaurantName": { "type": "string" },
        "itemsSummary": { "type": "string" },
        "itemTotal": { "type": "integer" },
        "deliveryFee": { "type": "integer" },
        "platformFee": { "type": "integer" },
        "gstAmount": { "type": "integer" },
        "discountAmount": { "type": "integer" },
        "couponCode": { "type": "string" },
        "totalAmount": { "type": "integer" },
        "paymentMethod": { "type": "string" },
        "paymentStatus": { "type": "string" },
        "paymentRef": { "type": "string" },
        "deliveryAddress": { "type": "string" },
        "status": { "type": "string" },
        "riderName": { "type": "string" },
        "riderPhone": { "type": "string" },
        "riderVehicle": { "type": "string" },
        "etaMinutes": { "type": "integer" },
        "otp": { "type": "string" },
        "rating": { "type": "integer" },
        "reviewText": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["orderNumber", "userId", "customerName", "restaurantId", "restaurantName", "itemsSummary", "itemTotal", "totalAmount", "paymentMethod", "paymentStatus", "deliveryAddress", "status", "otp", "rating", "createdAt", "updatedAt"]
    },
    "TakeItUser": {
      "title": "TakeItUser",
      "description": "Customer profile, wallet balance, favorites, and account status.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "avatarUrl": { "type": "string" },
        "activeAddressLabel": { "type": "string" },
        "activeAddressLine": { "type": "string" },
        "walletBalance": { "type": "number" },
        "goldMemberFlag": { "type": "boolean" },
        "suspendedFlag": { "type": "boolean" },
        "favoriteRestaurantIds": { "type": "array", "items": { "type": "string" } },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "name", "walletBalance", "goldMemberFlag", "suspendedFlag", "createdAt", "updatedAt"]
    },
    "Review": {
      "title": "Review",
      "description": "Customer rating & review for a restaurant.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "restaurantId": { "type": "string" },
        "orderId": { "type": "string" },
        "rating": { "type": "integer" },
        "comment": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "userName", "restaurantId", "rating", "comment", "createdAt"]
    },
    "SupportTicket": {
      "title": "SupportTicket",
      "description": "Customer help ticket managed & answered live by Admin.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "userEmail": { "type": "string" },
        "subject": { "type": "string" },
        "message": { "type": "string" },
        "status": { "type": "string" },
        "adminReply": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "userName", "subject", "message", "status", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/takeit_config/{configId}": {
      "schema": { "$ref": "#/entities/TakeItConfig" },
      "description": "Global live Take It app configuration."
    },
    "/takeit_co_admins/{coAdminEmail}": {
      "schema": { "$ref": "#/entities/CoAdmin" },
      "description": "Co-Admin registry managed exclusively by Main Admin buildolive4@gmail.com."
    },
    "/takeit_restaurants/{restaurantId}": {
      "schema": { "$ref": "#/entities/Restaurant" },
      "description": "Live restaurant directory."
    },
    "/takeit_menu_items/{itemId}": {
      "schema": { "$ref": "#/entities/MenuItem" },
      "description": "Live restaurant dishes."
    },
    "/takeit_coupons/{couponId}": {
      "schema": { "$ref": "#/entities/Coupon" },
      "description": "Live promotional coupons."
    },
    "/takeit_orders/{orderId}": {
      "schema": { "$ref": "#/entities/FoodOrder" },
      "description": "Global live food delivery orders."
    },
    "/takeit_users/{userId}": {
      "schema": { "$ref": "#/entities/TakeItUser" },
      "description": "Customer user profiles."
    },
    "/takeit_reviews/{reviewId}": {
      "schema": { "$ref": "#/entities/Review" },
      "description": "Verified customer restaurant reviews."
    },
    "/takeit_support_tickets/{ticketId}": {
      "schema": { "$ref": "#/entities/SupportTicket" },
      "description": "Customer help & support tickets."
    }
  }
}
